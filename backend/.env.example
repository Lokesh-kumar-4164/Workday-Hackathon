PORT=4001
DATABASE_URL=postgresql://user:password@localhost:5432/surgeshield
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4001
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4001/user/oauth/google/callback

# Redis configuration (Upstash or local Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
REDIS_URL=rediss://default:token@host:6379

# Rate Limiting
RATE_LIMIT_MAX_TOKENS=10
RATE_LIMIT_REFILL_RATE=1

# Downstream Email & Notification Resilience
EMAIL_SERVICE_URL=http://localhost:4001/api/downstream/email
EMAIL_SERVICE_TIMEOUT_MS=5000
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=1000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000
